# Stops Homebrew's /opt/homebrew/.editorconfig (2-space Ruby style) from applying here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,slnx,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
# Compact object initializers (several members per line) are the house style.
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

[src/Techies.Web/Data/Migrations/**.cs]
generated_code = true
charset = unset
