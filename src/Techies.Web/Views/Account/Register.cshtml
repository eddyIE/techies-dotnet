@model Techies.Web.ViewModels.Account.RegisterForm
@{ ViewData["Title"] = "Đăng ký"; }
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <form asp-action="Register" method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Tạo tài khoản</h1>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                @foreach (var field in new[] { "FullName", "Email", "Phone", "Password", "ConfirmPassword" })
                {
                    <div class="mb-3">
                        @Html.Label(field, null, new { @class = "form-label" })
                        @Html.Editor(field, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessage(field, null, new { @class = "text-danger small" })
                    </div>
                }
                <button class="btn btn-primary w-100">Đăng ký</button>
                <p class="mt-3 mb-0 text-center small">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
            </div>
        </form>
    </div>
</div>
