@if (User.Identity?.IsAuthenticated == true)
{
    <div class="dropdown">
        <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle"></i> @User.Identity.Name
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-area="" asp-controller="MyOrders" asp-action="Index">Đơn hàng của tôi</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="Points" asp-action="Index">Điểm thưởng & quà tặng</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button class="dropdown-item">Đăng xuất</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        <a class="btn btn-light btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
    </div>
}
