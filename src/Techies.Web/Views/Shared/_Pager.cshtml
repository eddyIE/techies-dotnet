@model int
@* Pager that keeps the current query string and only swaps ?page=. Model = total pages. *@
@{
    var totalPages = Model;
    var query = Context.Request.Query;
    var current = int.TryParse(query["page"], out var p) ? Math.Max(1, p) : 1;
    string Link(int page)
    {
        var parts = query.Where(kv => !kv.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"page={page}");
        return Context.Request.Path + "?" + string.Join("&", parts);
    }
}
@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang">
        <ul class="pagination pagination-sm">
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == current ? "active" : "")"><a class="page-link" href="@Link(i)">@i</a></li>
            }
        </ul>
    </nav>
}
