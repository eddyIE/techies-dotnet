@model Techies.Web.ViewModels.Shop.ProductCard
<div class="card h-100 product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="ratio ratio-1x1 bg-light">
        <img src="@Model.ThumbnailUrl" alt="@Model.Name" class="card-img-top p-3" style="object-fit:contain" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
    </a>
    <div class="card-body d-flex flex-column">
        <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-reset text-decoration-none small fw-semibold mb-2">@Model.Name</a>
        <div class="mt-auto">
            <div class="text-danger fw-bold">@Format.Money(Model.Price)</div>
            @if (Model.Available == 0) { <span class="badge text-bg-secondary">Hết hàng</span> }
        </div>
    </div>
</div>
