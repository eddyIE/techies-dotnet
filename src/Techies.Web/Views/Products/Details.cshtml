@model Techies.Web.ViewModels.Shop.ProductDetail
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var images = new[] { p.ThumbnailUrl }.Concat(p.Images.OrderBy(i => i.DisplayOrder).Select(i => i.Url)).Where(u => u is not null).Distinct().ToList();
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Category" asp-route-slug="@Model.CategorySlug">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@p.Name</li>
    </ol>
</nav>
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="ratio ratio-1x1 bg-white border rounded mb-2">
            <img id="main-image" src="@images.FirstOrDefault()" alt="@p.Name" class="p-3" style="object-fit:contain" onerror="this.src='/img/placeholder.svg'" />
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var url in images)
            {
                <button type="button" class="btn p-0 border rounded" onclick="document.getElementById('main-image').src='@url'">
                    <img src="@url" alt="" width="64" height="64" style="object-fit:contain" loading="lazy" />
                </button>
            }
        </div>
    </div>
    <div class="col-md-6">
        <h1 class="h3">@p.Name</h1>
        @if (Model.AverageRating is { } avg)
        {
            <div class="mb-2"><span class="text-warning">@for (var i = 1; i <= 5; i++) { <i class="bi @(i <= Math.Round(avg) ? "bi-star-fill" : "bi-star")"></i> }</span> <span class="small text-muted">@avg.ToString("0.0", Format.Vietnamese) (@Model.Reviews.Count đánh giá)</span></div>
        }
        <div class="fs-3 fw-bold text-danger mb-3">@Format.Money(p.Price)</div>
        @if (Model.Available == 0)
        {
            <div class="alert alert-secondary">Sản phẩm tạm hết hàng.</div>
        }
        else
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 mb-3" style="max-width: 320px">
                <input type="hidden" name="productId" value="@p.Id" />
                <input type="number" name="quantity" value="1" min="1" max="@Math.Min(99, Model.Available)" class="form-control" style="width: 90px" aria-label="Số lượng" />
                <button class="btn btn-primary flex-grow-1"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>
            </form>
            <div class="small text-muted mb-3">Còn @Model.Available sản phẩm · Miễn phí giao hàng cho đơn từ @Format.Money(Techies.Web.Services.OrderMath.FreeShippingFrom)</div>
        }
        <p>@p.Description</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-5">
        <h2 class="h5">Thông số kỹ thuật</h2>
        @if (p.Specs.Count == 0) { <p class="text-muted small">Chưa có thông số.</p> }
        else
        {
            <table class="table table-sm table-striped">
                <tbody>
                @foreach (var s in p.Specs.OrderBy(s => s.DisplayOrder)) { <tr><th class="w-50 fw-normal text-muted">@s.SpecName</th><td>@s.SpecValue</td></tr> }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-7">
        <h2 class="h5">Đánh giá của khách hàng</h2>
        @if (Model.Reviews.Count == 0) { <p class="text-muted small">Chưa có đánh giá.</p> }
        @foreach (var r in Model.Reviews)
        {
            <div class="border-bottom py-2">
                <div class="d-flex justify-content-between small">
                    <span class="fw-semibold">@r.CustomerName</span><span class="text-muted">@Format.LocalDate(r.CreatedAt)</span>
                </div>
                <div class="text-warning small">@for (var i = 1; i <= 5; i++) { <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i> }</div>
                @if (r.Comment is not null) { <div class="small">@r.Comment</div> }
            </div>
        }
    </div>
</div>
