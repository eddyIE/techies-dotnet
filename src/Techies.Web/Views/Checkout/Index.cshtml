@model Techies.Web.ViewModels.Shop.CheckoutForm
@{
    ViewData["Title"] = "Đặt hàng";
    var cart = (Techies.Web.Services.CartView)ViewData["Cart"]!;
    var addresses = (List<Address>)ViewData["Addresses"]!;
    var coupon = ViewData["Coupon"] as Techies.Web.Services.CouponCheck;
    var discount = coupon?.Applicable == true ? coupon.Discount : 0;
}
<h1 class="h4 mb-4">Đặt hàng</h1>
<form method="post" class="row g-4">
    <div class="col-lg-7">
        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
        <div class="card mb-4"><div class="card-body">
            <h2 class="h6 mb-3">Địa chỉ nhận hàng</h2>
            @foreach (var a in addresses)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="AddressId" id="addr-@a.Id" value="@a.Id" checked="@(Model.AddressId == a.Id)" />
                    <label class="form-check-label" for="addr-@a.Id">
                        <span class="fw-semibold">@a.RecipientName</span> — @a.Phone @if (a.IsDefault) { <span class="badge text-bg-light">Mặc định</span> }
                        <div class="small text-muted">@a.Line1, @a.Ward, @a.District, @a.Province</div>
                    </label>
                </div>
            }
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="AddressId" id="addr-new" value="" checked="@(Model.AddressId is null)" />
                <label class="form-check-label" for="addr-new">Giao đến địa chỉ mới</label>
            </div>
            <div id="new-address" class="border rounded p-3 mt-2">
                <div class="row g-2">
                    <div class="col-md-6"><label asp-for="RecipientName" class="form-label small"></label><input asp-for="RecipientName" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Phone" class="form-label small"></label><input asp-for="Phone" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Line1" class="form-label small"></label><input asp-for="Line1" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Ward" class="form-label small"></label><input asp-for="Ward" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="District" class="form-label small"></label><input asp-for="District" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Province" class="form-label small"></label><input asp-for="Province" class="form-control" /></div>
                    <div class="col-12 form-check ms-1"><input asp-for="MakeDefault" class="form-check-input" /><label asp-for="MakeDefault" class="form-check-label small"></label></div>
                </div>
            </div>
        </div></div>
        <div class="card"><div class="card-body">
            <h2 class="h6">Phương thức thanh toán</h2>
            <div class="form-check">
                <input class="form-check-input" type="radio" checked disabled id="cod" />
                <label class="form-check-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
            </div>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h2 class="h6 mb-3">Đơn hàng (@cart.Lines.Sum(l => l.Quantity) sản phẩm)</h2>
            @foreach (var l in cart.Lines)
            {
                <div class="d-flex justify-content-between small mb-1"><span>@l.Name × @l.Quantity</span><span>@Format.Money(l.LineTotal)</span></div>
            }
            <hr />
            <div class="d-flex justify-content-between"><span>Tạm tính</span><span>@Format.Money(cart.Subtotal)</span></div>
            <div class="d-flex justify-content-between"><span>Phí vận chuyển</span><span>@(cart.ShippingFee == 0 ? "Miễn phí" : Format.Money(cart.ShippingFee))</span></div>
            @if (discount > 0)
            {
                <div class="d-flex justify-content-between text-success"><span>Giảm giá (@coupon!.Code)</span><span>−@Format.Money(discount)</span></div>
            }
            <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Tổng cộng</span><span class="text-danger">@Format.Money(cart.Total - discount)</span></div>
            <hr />
            <label asp-for="CouponCode" class="form-label small mb-1"></label>
            <div class="input-group">
                <input asp-for="CouponCode" class="form-control text-uppercase" placeholder="VD: TECHIES50K" />
                <button class="btn btn-outline-primary" name="apply" value="true" formnovalidate>Áp dụng</button>
            </div>
            @if (coupon?.Applicable == true)
            {
                <div class="small text-success mt-1"><i class="bi bi-check-circle"></i> Đã áp dụng mã @coupon.Code: giảm @Format.Money(coupon.Discount).</div>
            }
            else if (coupon?.Message is not null)
            {
                <div class="small text-danger mt-1">@coupon.Message</div>
            }
            <button class="btn btn-primary w-100 mt-3">Xác nhận đặt hàng</button>
        </div></div>
    </div>
</form>
@section Scripts {
<script>
    // Show the new-address fields only when "Giao đến địa chỉ mới" is selected.
    const toggle = () => document.getElementById("new-address").hidden = !document.getElementById("addr-new").checked;
    document.querySelectorAll("input[name=AddressId]").forEach(r => r.addEventListener("change", toggle));
    toggle();
</script>
}
