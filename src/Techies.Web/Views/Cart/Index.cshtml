@model Techies.Web.Services.CartView
@{ ViewData["Title"] = "Giỏ hàng"; }
<h1 class="h4 mb-4">Giỏ hàng</h1>
@if (Model.Lines.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-cart3 display-4 text-muted"></i>
        <p class="mt-3">Giỏ hàng của bạn đang trống.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <ul class="list-group list-group-flush">
                @foreach (var l in Model.Lines)
                {
                    <li class="list-group-item d-flex gap-3 align-items-center">
                        <img src="@l.ThumbnailUrl" alt="" width="72" height="72" style="object-fit:contain" onerror="this.src='/img/placeholder.svg'" />
                        <div class="flex-grow-1">
                            <a asp-controller="Products" asp-action="Details" asp-route-slug="@l.Slug" class="text-reset fw-semibold text-decoration-none">@l.Name</a>
                            <div class="small text-muted">@Format.Money(l.UnitPrice)</div>
                            @if (l.Available < l.Quantity) { <div class="small text-danger">Chỉ còn @l.Available sản phẩm</div> }
                        </div>
                        <form asp-action="Update" method="post" class="d-flex gap-1">
                            <input type="hidden" name="productId" value="@l.ProductId" />
                            <input type="number" name="quantity" value="@l.Quantity" min="0" max="@Math.Min(99, l.Available)" class="form-control form-control-sm" style="width: 72px" aria-label="Số lượng" onchange="this.form.submit()" />
                        </form>
                        <div class="fw-semibold text-end" style="width: 120px">@Format.Money(l.LineTotal)</div>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@l.ProductId" />
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </li>
                }
                </ul>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between"><span>Tạm tính</span><span>@Format.Money(Model.Subtotal)</span></div>
                <div class="d-flex justify-content-between"><span>Phí vận chuyển</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : Format.Money(Model.ShippingFee))</span></div>
                <hr />
                <div class="d-flex justify-content-between fw-bold fs-5"><span>Tổng cộng</span><span class="text-danger">@Format.Money(Model.Total)</span></div>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100 mt-3">Đặt hàng</a>
            </div></div>
        </div>
    </div>
}
