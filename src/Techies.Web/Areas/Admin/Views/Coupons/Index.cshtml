@model Techies.Web.Infrastructure.Grid.GridModel
@{ ViewData["Title"] = "Mã giảm giá"; }
@if (await Staff.HasAsync(Permissions.CouponsManage))
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Admin" asp-controller="Coupons" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tạo mã</a>
    </div>
}
<div data-grid id="coupons-grid"><partial name="_Grid" model="Model" /></div>
