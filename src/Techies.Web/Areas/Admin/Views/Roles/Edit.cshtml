@model Techies.Web.ViewModels.Staff.RoleForm
@{
    var id = ViewData["Id"] as int?;
    var isSystem = (bool)ViewData["IsSystem"]!;
    ViewData["Title"] = id is null ? "Thêm vai trò" : isSystem ? "Vai trò hệ thống" : "Sửa vai trò";
    var granted = Model.Permissions.ToHashSet();
}
<form method="post" asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" id="role-form">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    @if (isSystem)
    {
        <div class="alert alert-info">Quản trị viên cao cấp là vai trò hệ thống: luôn có toàn quyền, quản lý nhân sự và phân quyền. Có thể đổi tên và mô tả; không thể đổi quyền hoặc xóa.</div>
    }
    <div class="card mb-4" style="max-width: 720px"><div class="card-body">
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
        <div><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
    </div></div>
    <fieldset disabled="@isSystem">
        <h2 class="h6">Quyền được phép</h2>
        <div class="row g-3 mb-4">
            @foreach (var group in Permissions.All.GroupBy(p => p.Module))
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100" data-permission-group>
                        <div class="card-header bg-white">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="group-@group.First().Id" data-select-group />
                                <label class="form-check-label fw-semibold" for="group-@group.First().Id">@group.Key</label>
                            </div>
                        </div>
                        <div class="card-body">
                            @foreach (var p in group)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Permissions" value="@p.Code" id="perm-@p.Id" checked="@granted.Contains(p.Code)" />
                                    <label class="form-check-label" for="perm-@p.Id">@p.Name <span class="text-muted small font-monospace">@p.Code</span></label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </fieldset>
    <div class="d-flex gap-2">
        <button class="btn btn-primary">Lưu vai trò</button>
        <a asp-action="Index" class="btn btn-link">Quay lại</a>
    </div>
</form>
@if (id is not null && !isSystem)
{
    <form asp-action="Delete" asp-route-id="@id" method="post" class="mt-3" onsubmit="return confirm('Xóa vai trò này?')">
        <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Xóa vai trò</button>
    </form>
}
@section Scripts {
<script>
    // "Chọn cả nhóm": the group box mirrors (and sets) every permission in its card.
    document.querySelectorAll("[data-permission-group]").forEach(card => {
        const all = card.querySelector("[data-select-group]");
        const items = [...card.querySelectorAll("input[name=Permissions]")];
        const sync = () => { all.checked = items.every(i => i.checked); all.indeterminate = !all.checked && items.some(i => i.checked); };
        all.addEventListener("change", () => { items.forEach(i => i.checked = all.checked); sync(); });
        items.forEach(i => i.addEventListener("change", sync));
        sync();
    });
</script>
}
