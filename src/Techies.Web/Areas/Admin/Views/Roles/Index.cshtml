@model List<Techies.Web.ViewModels.Staff.RoleRow>
@{ ViewData["Title"] = "Vai trò & Phân quyền"; }
<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm vai trò</a>
</div>
<div class="card">
    <table class="table mb-0">
        <thead><tr><th>Vai trò</th><th>Mô tả</th><th class="text-end">Nhân viên</th><th class="text-end">Quyền</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name @if (r.IsSystem) { <span class="badge text-bg-dark">Hệ thống</span> }</td>
                <td class="small text-muted">@r.Description</td>
                <td class="text-end">@r.StaffCount</td>
                <td class="text-end">@(r.IsSystem ? "Toàn quyền" : $"{r.PermissionCount}/{Permissions.All.Count}")</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">@(r.IsSystem ? "Xem" : "Sửa")</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
