@model Paged<Techies.Web.ViewModels.Customers.ReviewRow>
@{
    ViewData["Title"] = "Đánh giá sản phẩm";
    var filter = (Techies.Web.ViewModels.Customers.ReviewFilter)ViewData["Filter"]!;
    var products = (List<(Guid Id, string Name)>)ViewData["Products"]!;
}
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label small">Sản phẩm</label>
        <select name="productId" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var p in products) { <option value="@p.Id" selected="@(filter.ProductId == p.Id)">@p.Name</option> }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">Số sao</label>
        <select name="rating" class="form-select">
            <option value="">Tất cả</option>
            @for (short i = 5; i >= 1; i--) { <option value="@i" selected="@(filter.Rating == i)">@i sao</option> }
        </select>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input class="form-check-input" type="checkbox" name="lowOnly" value="true" id="low" checked="@filter.LowOnly" />
        <label class="form-check-label" for="low">Chỉ đánh giá 1–2 sao</label>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">Lọc</button></div>
    <div class="col text-end"><a asp-action="Index" asp-route-lowOnly="true" class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle"></i> Đánh giá thấp</a></div>
</form>
<div class="card">
    <table class="table mb-0">
        <thead><tr><th>Thời gian</th><th>Sản phẩm</th><th>Khách hàng</th><th>Đánh giá</th><th>Nhận xét</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Items)
        {
            <tr class="@(r.Rating <= 2 ? "table-danger" : "")">
                <td class="small text-nowrap">@Format.LocalTime(r.CreatedAt)</td>
                <td class="small">@r.ProductName</td>
                <td class="small"><a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerId">@r.CustomerName</a></td>
                <td class="text-warning text-nowrap">@for (var i = 1; i <= 5; i++) { <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i> }</td>
                <td class="small">@r.Comment</td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Không có đánh giá phù hợp.</td></tr> }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model.TotalPages" />
