@model Techies.Web.Infrastructure.Grid.GridModel
@{ ViewData["Title"] = "Sản phẩm"; }
@if (await Staff.HasAsync(Permissions.ProductsEdit))
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
    </div>
}
<div data-grid id="products-grid"><partial name="_Grid" model="Model" /></div>
