@model IEnumerable<Techies.Web.Infrastructure.Grid.GridRowAction>
@{ var actions = Model.ToList(); var grid = (Techies.Web.Infrastructure.Grid.GridModel)ViewData["Grid"]!; }
<td class="text-end text-nowrap">
    @if (actions.Count > 0)
    {
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Chọn</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var a in actions)
                {
                    <li>
                        @if (a.Post)
                        {
                            <form method="post" action="@a.Url" data-confirm="@a.Confirm" asp-antiforgery="true">
                                <input type="hidden" name="returnUrl" value="@grid.Request.Url" />
                                <button class="dropdown-item @(a.Danger ? "text-danger" : "")">@a.Label</button>
                            </form>
                        }
                        else
                        {
                            <a class="dropdown-item" href="@a.Url" target="@(a.NewTab ? "_blank" : null)">@a.Label</a>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</td>
