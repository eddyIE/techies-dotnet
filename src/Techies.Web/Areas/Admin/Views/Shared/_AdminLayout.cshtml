<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Techies CMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex min-vh-100">
        <nav class="admin-sidebar bg-dark text-white flex-shrink-0 p-3 d-print-none">
            <a class="d-block fs-5 fw-bold text-white text-decoration-none mb-3" href="/admin"><i class="bi bi-lightning-charge-fill"></i> Techies CMS</a>
            <partial name="_AdminMenu" />
        </nav>
        <div class="flex-grow-1 d-flex flex-column bg-light">
            <header class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center d-print-none">
                <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                <partial name="_AdminUser" />
            </header>
            <main class="p-4 flex-grow-1">
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-grid.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
