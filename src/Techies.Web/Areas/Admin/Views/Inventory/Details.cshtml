@model List<Techies.Web.Services.AdjustmentRow>
@{
    var product = (Product)ViewData["Product"]!;
    var available = (int)ViewData["Available"]!;
    ViewData["Title"] = "Tồn kho: " + product.Name;
}
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-center h-100"><div class="card-body">
            <div class="text-muted small">Tồn khả dụng hiện tại</div>
            <div class="display-5 fw-bold @(available == 0 ? "text-danger" : "")">@available</div>
        </div></div>
    </div>
    @if (await Staff.HasAsync(Permissions.InventoryImport))
    {
    <div class="col-md-4">
        <form asp-action="Import" asp-route-id="@product.Id" method="post" class="card h-100"><div class="card-body">
            <h2 class="h6"><i class="bi bi-box-arrow-in-down"></i> Nhập hàng</h2>
            <input name="quantity" type="number" min="1" required class="form-control mb-2" placeholder="Số lượng nhập thêm" />
            <input name="reason" class="form-control mb-2" placeholder="Ghi chú (VD: lô hàng tháng 10)" />
            <button class="btn btn-primary w-100">Cộng vào kho</button>
        </div></form>
    </div>
    }
    @if (await Staff.HasAsync(Permissions.InventoryCount))
    {
    <div class="col-md-4">
        <form asp-action="Count" asp-route-id="@product.Id" method="post" class="card h-100"><div class="card-body">
            <h2 class="h6"><i class="bi bi-clipboard-check"></i> Kiểm kê</h2>
            <input name="quantity" type="number" min="0" required class="form-control mb-2" placeholder="Số lượng thực tế đếm được" />
            <input name="reason" class="form-control mb-2" placeholder="Lý do chênh lệch" />
            <button class="btn btn-outline-primary w-100">Cập nhật số thực tế</button>
        </div></form>
    </div>
    }
</div>
<div class="card">
    <div class="card-header">Lịch sử biến động kho</div>
    <table class="table mb-0">
        <thead><tr><th>Thời gian</th><th>Loại</th><th class="text-end">Thay đổi</th><th class="text-end">Trước</th><th class="text-end">Sau</th><th>Ghi chú</th><th>Người thực hiện</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td class="small">@Format.LocalTime(a.CreatedAt)</td>
                <td>@Labels.For(a.Type)</td>
                <td class="text-end @(a.Delta < 0 ? "text-danger" : "text-success")">@(a.Delta > 0 ? "+" : "")@a.Delta</td>
                <td class="text-end">@a.Before</td>
                <td class="text-end">@a.After</td>
                <td class="small">@a.Reason</td>
                <td class="small">@(a.StaffName ?? "Hệ thống")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có biến động.</td></tr> }
        </tbody>
    </table>
</div>
<a asp-action="Index" class="btn btn-link mt-3">Quay lại danh sách</a>
