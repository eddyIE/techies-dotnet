@model Paged<Techies.Web.ViewModels.Catalog.ProductRow>
@{
    ViewData["Title"] = "Kiểm kho & Nhập hàng";
    var filter = (Techies.Web.ViewModels.Catalog.ProductFilter)ViewData["Filter"]!;
}
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5"><input name="q" value="@filter.Q" class="form-control" placeholder="Tìm sản phẩm..." /></div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" name="outOfStock" value="true" id="oos" checked="@filter.OutOfStock" />
        <label class="form-check-label" for="oos">Chỉ hàng hết</label>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">Lọc</button></div>
</form>
<div class="card">
    <table class="table mb-0">
        <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th class="text-end">Tồn khả dụng</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>@p.Name @if (!p.Active) { <span class="badge text-bg-secondary ms-1">Ngừng bán</span> }</td>
                <td class="text-muted">@p.CategoryName</td>
                <td class="text-end">
                    @if (p.Available == 0) { <span class="badge text-bg-danger">0</span> }
                    else if (p.Available <= 5) { <span class="badge text-bg-warning">@p.Available</span> }
                    else { @p.Available }
                </td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Nhập / Kiểm kê</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model.TotalPages" />
