@model List<(Gift Row, List<Techies.Web.Infrastructure.Grid.GridRowAction> Actions)>
@{ var tiers = (Dictionary<short, string>)ViewData["Tiers"]!; }
@foreach (var (g, actions) in Model)
{
    <tr>
        <partial name="_GridSelect" model="g.Id.ToString()" view-data="ViewData" />
        <td style="width:56px"><img src="@g.ImageUrl" alt="" width="44" height="44" class="rounded" style="object-fit:cover" loading="lazy" onerror="this.style.visibility='hidden'" /></td>
        <td>@g.Name<div class="small text-muted">@g.Description</div></td>
        <td class="text-end">@g.PointsCost.ToString("#,0", Format.Vietnamese)</td>
        <td>@tiers.GetValueOrDefault(g.MinTier)</td>
        <td class="text-end">@if (g.StockAvailable == 0) { <span class="badge text-bg-danger">Hết quà</span> } else { @g.StockAvailable }</td>
        <td>@if (g.Active) { <span class="badge text-bg-success">Mở đổi</span> } else { <span class="badge text-bg-secondary">Tạm khóa</span> }</td>
        <partial name="_GridRowActions" model="actions" view-data="ViewData" />
    </tr>
}
