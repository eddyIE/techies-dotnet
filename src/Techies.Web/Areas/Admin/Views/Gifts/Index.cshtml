@model Techies.Web.Infrastructure.Grid.GridModel
@{ ViewData["Title"] = "Quà tặng đổi điểm"; }
@if (await Staff.HasAsync(Permissions.GiftsManage))
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Admin" asp-controller="Gifts" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm quà</a>
    </div>
}
<div data-grid id="gifts-grid"><partial name="_Grid" model="Model" /></div>
