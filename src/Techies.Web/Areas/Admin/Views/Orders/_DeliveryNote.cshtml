@model Order
@{ var collect = Techies.Web.Services.OrderMath.AmountToCollect(Model); }
<div class="note mx-auto p-4">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
        <div>
            <div class="fs-4 fw-bold">TECHIES</div>
            <div class="small text-muted">Phiếu giao hàng</div>
        </div>
        <div class="text-end">
            <div class="fs-5 fw-bold font-monospace">@Model.OrderRef</div>
            <div class="small">Ngày đặt: @Format.LocalTime(Model.CreatedAt)</div>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-7">
            <div class="small text-muted">Người nhận</div>
            <div class="fw-semibold">@Model.ShipRecipient</div>
            <div>@Model.ShipPhone</div>
            <div>@Model.ShipLine1, @Model.ShipWard, @Model.ShipDistrict, @Model.ShipProvince</div>
        </div>
        <div class="col-5 text-end">
            <div class="small text-muted">Số tiền cần thu hộ</div>
            <div class="collect fw-bold">@Format.Money(collect)</div>
            <div class="small">@Labels.For(Model.PaymentMethod)</div>
        </div>
    </div>
    <table class="table table-sm table-bordered">
        <thead><tr><th>#</th><th>Sản phẩm</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead>
        <tbody>
        @{ var n = 0; }
        @foreach (var i in Model.Items)
        {
            <tr><td>@(++n)</td><td>@i.ProductName</td><td class="text-end">@i.Quantity</td><td class="text-end">@Format.Money(i.UnitPrice)</td><td class="text-end">@Format.Money(i.LineTotal)</td></tr>
        }
        </tbody>
        <tfoot>
            <tr><td colspan="4" class="text-end">Tạm tính</td><td class="text-end">@Format.Money(Model.Subtotal)</td></tr>
            <tr><td colspan="4" class="text-end">Phí vận chuyển</td><td class="text-end">@Format.Money(Model.ShippingFee)</td></tr>
            @if (Model.Discount > 0) { <tr><td colspan="4" class="text-end">Giảm giá</td><td class="text-end">−@Format.Money(Model.Discount)</td></tr> }
            <tr class="fw-bold"><td colspan="4" class="text-end">Tổng cộng</td><td class="text-end">@Format.Money(Model.Total)</td></tr>
        </tfoot>
    </table>
    <div class="row text-center small mt-5">
        <div class="col">Người giao hàng<br /><br /><br />(Ký, ghi rõ họ tên)</div>
        <div class="col">Người nhận hàng<br /><br /><br />(Ký, ghi rõ họ tên)</div>
    </div>
</div>
